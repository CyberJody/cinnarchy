# Omarchy Cinnamon GTK 2 fallback; uses GTK's built-in engine.
gtk-color-scheme = "bg_color:#142620\nfg_color:#dfede5\nbase_color:#0f1e19\ntext_color:#dfede5\nselected_bg_color:#8bcbb1\nselected_fg_color:#142620\ntooltip_bg_color:#0f1e19\ntooltip_fg_color:#dfede5"
style "omarchy-default" {
  xthickness = 2
  ythickness = 2
  bg[NORMAL] = "#142620"
  bg[PRELIGHT] = "#334d43"
  bg[ACTIVE] = "#203b31"
  bg[SELECTED] = "#8bcbb1"
  bg[INSENSITIVE] = "#142620"
  fg[NORMAL] = "#dfede5"
  fg[PRELIGHT] = "#dfede5"
  fg[ACTIVE] = "#dfede5"
  fg[SELECTED] = "#142620"
  fg[INSENSITIVE] = "#8e9d96"
  base[NORMAL] = "#0f1e19"
  base[SELECTED] = "#8bcbb1"
  base[ACTIVE] = "#2b5147"
  base[INSENSITIVE] = "#203b31"
  text[NORMAL] = "#dfede5"
  text[SELECTED] = "#142620"
  text[ACTIVE] = "#dfede5"
  text[INSENSITIVE] = "#8e9d96"
}
class "*" style "omarchy-default"
