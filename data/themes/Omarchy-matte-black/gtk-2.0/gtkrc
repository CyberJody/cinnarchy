# Omarchy Cinnamon GTK 2 fallback; uses GTK's built-in engine.
gtk-color-scheme = "bg_color:#121212\nfg_color:#bebebe\nbase_color:#0d0d0d\ntext_color:#bebebe\nselected_bg_color:#e68e0d\nselected_fg_color:#121212\ntooltip_bg_color:#0d0d0d\ntooltip_fg_color:#bebebe"
style "omarchy-default" {
  xthickness = 2
  ythickness = 2
  bg[NORMAL] = "#121212"
  bg[PRELIGHT] = "#2e2e2e"
  bg[ACTIVE] = "#1e1e1e"
  bg[SELECTED] = "#e68e0d"
  bg[INSENSITIVE] = "#121212"
  fg[NORMAL] = "#bebebe"
  fg[PRELIGHT] = "#bebebe"
  fg[ACTIVE] = "#bebebe"
  fg[SELECTED] = "#121212"
  fg[INSENSITIVE] = "#797979"
  base[NORMAL] = "#0d0d0d"
  base[SELECTED] = "#e68e0d"
  base[ACTIVE] = "#2a2a2a"
  base[INSENSITIVE] = "#1e1e1e"
  text[NORMAL] = "#bebebe"
  text[SELECTED] = "#121212"
  text[ACTIVE] = "#bebebe"
  text[INSENSITIVE] = "#797979"
}
class "*" style "omarchy-default"
