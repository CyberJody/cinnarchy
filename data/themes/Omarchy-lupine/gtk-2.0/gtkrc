# Omarchy Cinnamon GTK 2 fallback; uses GTK's built-in engine.
gtk-color-scheme = "bg_color:#fafafa\nfg_color:#212121\nbase_color:#ececec\ntext_color:#212121\nselected_bg_color:#3264eb\nselected_fg_color:#fafafa\ntooltip_bg_color:#ececec\ntooltip_fg_color:#212121"
style "omarchy-default" {
  xthickness = 2
  ythickness = 2
  bg[NORMAL] = "#fafafa"
  bg[PRELIGHT] = "#e0e0e0"
  bg[ACTIVE] = "#f5f5f5"
  bg[SELECTED] = "#3264eb"
  bg[INSENSITIVE] = "#fafafa"
  fg[NORMAL] = "#212121"
  fg[PRELIGHT] = "#212121"
  fg[ACTIVE] = "#212121"
  fg[SELECTED] = "#fafafa"
  fg[INSENSITIVE] = "#787878"
  base[NORMAL] = "#ececec"
  base[SELECTED] = "#3264eb"
  base[ACTIVE] = "#d0d0d0"
  base[INSENSITIVE] = "#f5f5f5"
  text[NORMAL] = "#212121"
  text[SELECTED] = "#fafafa"
  text[ACTIVE] = "#212121"
  text[INSENSITIVE] = "#787878"
}
class "*" style "omarchy-default"
