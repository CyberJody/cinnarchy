# Omarchy Cinnamon GTK 2 fallback; uses GTK's built-in engine.
gtk-color-scheme = "bg_color:#1c1c1e\nfg_color:#f5f5f7\nbase_color:#161618\ntext_color:#f5f5f7\nselected_bg_color:#ff9f0a\nselected_fg_color:#1c1c1e\ntooltip_bg_color:#161618\ntooltip_fg_color:#f5f5f7"
style "omarchy-default" {
  xthickness = 2
  ythickness = 2
  bg[NORMAL] = "#1c1c1e"
  bg[PRELIGHT] = "#404042"
  bg[ACTIVE] = "#2c2c2e"
  bg[SELECTED] = "#ff9f0a"
  bg[INSENSITIVE] = "#1c1c1e"
  fg[NORMAL] = "#f5f5f7"
  fg[PRELIGHT] = "#f5f5f7"
  fg[ACTIVE] = "#f5f5f7"
  fg[SELECTED] = "#1c1c1e"
  fg[INSENSITIVE] = "#9e9ea0"
  base[NORMAL] = "#161618"
  base[SELECTED] = "#ff9f0a"
  base[ACTIVE] = "#3a3a3c"
  base[INSENSITIVE] = "#2c2c2e"
  text[NORMAL] = "#f5f5f7"
  text[SELECTED] = "#1c1c1e"
  text[ACTIVE] = "#f5f5f7"
  text[INSENSITIVE] = "#9e9ea0"
}
class "*" style "omarchy-default"
