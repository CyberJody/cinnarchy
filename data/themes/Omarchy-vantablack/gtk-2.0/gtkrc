# Omarchy Cinnamon GTK 2 fallback; uses GTK's built-in engine.
gtk-color-scheme = "bg_color:#000000\nfg_color:#ffffff\nbase_color:#090909\ntext_color:#ffffff\nselected_bg_color:#8d8d8d\nselected_fg_color:#000000\ntooltip_bg_color:#090909\ntooltip_fg_color:#ffffff"
style "omarchy-default" {
  xthickness = 2
  ythickness = 2
  bg[NORMAL] = "#000000"
  bg[PRELIGHT] = "#313131"
  bg[ACTIVE] = "#1a1a1a"
  bg[SELECTED] = "#8d8d8d"
  bg[INSENSITIVE] = "#000000"
  fg[NORMAL] = "#ffffff"
  fg[PRELIGHT] = "#ffffff"
  fg[ACTIVE] = "#ffffff"
  fg[SELECTED] = "#000000"
  fg[INSENSITIVE] = "#999999"
  base[NORMAL] = "#090909"
  base[SELECTED] = "#8d8d8d"
  base[ACTIVE] = "#1a1a1a"
  base[INSENSITIVE] = "#1a1a1a"
  text[NORMAL] = "#ffffff"
  text[SELECTED] = "#000000"
  text[ACTIVE] = "#ffffff"
  text[INSENSITIVE] = "#999999"
}
class "*" style "omarchy-default"
