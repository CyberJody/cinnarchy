# Omarchy Cinnamon GTK 2 fallback; uses GTK's built-in engine.
gtk-color-scheme = "bg_color:#1a1b26\nfg_color:#a9b1d6\nbase_color:#13141c\ntext_color:#a9b1d6\nselected_bg_color:#7aa2f7\nselected_fg_color:#1a1b26\ntooltip_bg_color:#13141c\ntooltip_fg_color:#a9b1d6"
style "omarchy-default" {
  xthickness = 2
  ythickness = 2
  bg[NORMAL] = "#1a1b26"
  bg[PRELIGHT] = "#31364a"
  bg[ACTIVE] = "#24283b"
  bg[SELECTED] = "#7aa2f7"
  bg[INSENSITIVE] = "#1a1b26"
  fg[NORMAL] = "#a9b1d6"
  fg[PRELIGHT] = "#a9b1d6"
  fg[ACTIVE] = "#a9b1d6"
  fg[SELECTED] = "#1a1b26"
  fg[INSENSITIVE] = "#707590"
  base[NORMAL] = "#13141c"
  base[SELECTED] = "#7aa2f7"
  base[ACTIVE] = "#292e42"
  base[INSENSITIVE] = "#24283b"
  text[NORMAL] = "#a9b1d6"
  text[SELECTED] = "#1a1b26"
  text[ACTIVE] = "#a9b1d6"
  text[INSENSITIVE] = "#707590"
}
class "*" style "omarchy-default"
